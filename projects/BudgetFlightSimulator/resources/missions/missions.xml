        <Stage type="RING_GATE" description="Victory flyby: Glideslope Gate">
            <Position x="-5500.0" y="170.0" z="150.0"/>
            <Radius>90.0</Radius>
        </Stage>

        <Stage type="LANDING" description="Final victory touchdown on West Island Runway">
            <Position x="-4500.0" y="111.5" z="150.0"/>
            <Radius>300.0</Radius>
            <MaxSpeed>220.0</MaxSpeed>
        </Stage>
