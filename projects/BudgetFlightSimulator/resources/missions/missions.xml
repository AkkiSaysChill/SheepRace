            <Enemy id="armada_wing_2" name="Armada Wingman 2" type="AIR_PATROL" targetStage="1">
                <Position x="-400.0" y="450.0" z="-4700.0"/>
                <Health>130.0</Health>
                <Radius>26.0</Radius>
                <Speed>150.0</Speed>
