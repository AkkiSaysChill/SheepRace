        <Stage type="LANDING" description="Recover at West Runway">
            <Position x="-4500.0" y="111.5" z="150.0"/>
            <Radius>280.0</Radius>
            <MaxSpeed>230.0</MaxSpeed>
        </Stage>
    </Mission>

    <!-- Mission 06: Midnight Intercept -->
    <Mission id="campaign_06_intercept" 
             title="Midnight Intercept" 
             plane="jet_mk2" 
             description="Hostile night raid detected over the channel. Use HUD radar lock to destroy three incoming aces.">
        <Spawn x="-4850.0" y="111.5" z="150.0" heading="90.0"/>
        <Environment time="23.5" weather="OVERCAST"/>

        <Enemies>
            <Enemy id="night_raider_1" name="Shadow Ace Alpha" type="AIR_PATROL" targetStage="1">
                <Position x="-500.0" y="520.0" z="-1000.0"/>
                <Health>120.0</Health>
                <Radius>28.0</Radius>
                <Speed>145.0</Speed>
            </Enemy>
            <Enemy id="night_raider_2" name="Shadow Ace Bravo" type="AIR_PATROL" targetStage="1">
                <Position x="200.0" y="500.0" z="-1200.0"/>
                <Health>120.0</Health>
                <Radius>28.0</Radius>
                <Speed>145.0</Speed>
            </Enemy>
            <Enemy id="night_raider_3" name="Shadow Ace Charlie" type="AIR_PATROL" targetStage="1">
                <Position x="-1200.0" y="540.0" z="-2000.0"/>
                <Health>120.0</Health>
                <Radius>28.0</Radius>
                <Speed>140.0</Speed>
            </Enemy>
        </Enemies>

        <Stage type="TAKEOFF" description="Night climb-out: Intercept hostile vector South">
            <Position x="-4200.0" y="240.0" z="-800.0"/>
            <Radius>400.0</Radius>
            <MinSpeed>250.0</MinSpeed>
            <MinAltitude>200.0</MinAltitude>
        </Stage>

        <Stage type="TARGET_STRIKE" event="DESTROY_TARGET" description="Splash all 3 Shadow Aces in zero-visibility">
            <Position x="-500.0" y="520.0" z="-3000.0"/>
            <Radius>350.0</Radius>
        </Stage>

        <Stage type="RING_GATE" description="West Runway approach marker">
            <Position x="-5500.0" y="180.0" z="150.0"/>
            <Radius>90.0</Radius>
        </Stage>

        <Stage type="LANDING" description="Instrument night landing on West Strip">
            <Position x="-4500.0" y="111.5" z="150.0"/>
            <Radius>260.0</Radius>
            <MaxSpeed>220.0</MaxSpeed>
        </Stage>
    </Mission>

    <!-- Mission 07: Heavy Lift Under Fire -->
    <Mission id="campaign_07_heavylift" 
             title="Heavy Lift Under Fire" 
             plane="cargo" 
             radar="true"
             description="Deliver emergency munitions to the frontline crater while evading PMC jet interceptors.">
        <Spawn x="0.0" y="23.5" z="-8500.0" heading="0.0"/>
        <Environment time="16.0" weather="STORMY_RAIN"/>

        <Enemies>
            <Enemy id="canyon_patrol_1" name="PMC Interceptor Wardog" type="AIR_PATROL" targetStage="2">
                <Position x="-1800.0" y="320.0" z="2000.0"/>
                <Health>90.0</Health>
                <Radius>30.0</Radius>
                <Speed>135.0</Speed>
            </Enemy>
        </Enemies>

