        <Spawn x="-4850.0" y="111.5" z="150.0" heading="90.0"/>
        <Environment time="19.2" weather="PARTLY_CLOUDY"/>

        <Enemies>
            <Enemy id="crater_guard_1" name="Base Guard Falcon" type="AIR_PATROL" targetStage="3">
