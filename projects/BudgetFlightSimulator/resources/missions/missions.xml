<Missions>
    <!-- =================================================================== -->
    <!-- ACT I: THE FREELANCER (Missions 01 - 04)                             -->
    <!-- =================================================================== -->

    <!-- Mission 01: Maiden Flight -->
    <Mission id="campaign_01_maiden" 
             title="Maiden Flight" 
             plane="trainer" 
             description="Take off from West Strip, climb above 140m, pass the Coastal Arch, and return for landing.">
        <Spawn x="-4850.0" y="111.5" z="150.0" heading="90.0"/>
        <Environment time="7.5" weather="CLEAR"/>
        
        <Stage type="TAKEOFF" description="Climb out heading East past 140m">
            <Position x="-4200.0" y="140.0" z="150.0"/>
            <Radius>350.0</Radius>
            <MinSpeed>135.0</MinSpeed>
            <MinAltitude>140.0</MinAltitude>
        </Stage>

        <Stage type="RING_GATE" description="Fly through Coastal Rock Arch">
            <Position x="-3200.0" y="170.0" z="450.0"/>
            <Radius>80.0</Radius>
        </Stage>

        <Stage type="WAYPOINT" description="Bank around Southern Headland">
            <Position x="-4200.0" y="200.0" z="-950.0"/>
            <Radius>220.0</Radius>
        </Stage>

        <Stage type="RING_GATE" description="Align with final approach glideslope">
            <Position x="-5500.0" y="160.0" z="150.0"/>
            <Radius>75.0</Radius>
        </Stage>

        <Stage type="LANDING" description="Touch down smoothly on West Island Runway">
            <Position x="-4500.0" y="111.5" z="150.0"/>
            <Radius>250.0</Radius>
            <MaxSpeed>180.0</MaxSpeed>
        </Stage>
    </Mission>

    <!-- Mission 02: Squall Rescue -->
