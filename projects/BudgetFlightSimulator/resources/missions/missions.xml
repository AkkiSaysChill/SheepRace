                <Radius>25.0</Radius>
                <Speed>140.0</Speed>
            </Enemy>
            <Enemy id="crater_guard_2" name="Base Guard Viper" type="AIR_PATROL" targetStage="3">
                <Position x="1500.0" y="340.0" z="1600.0"/>
                <Health>140.0</Health>
                <Radius>25.0</Radius>
                <Speed>140.0</Speed>
