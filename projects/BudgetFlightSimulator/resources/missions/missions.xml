        <Spawn x="-4850.0" y="111.5" z="150.0" heading="90.0"/>
        <Environment time="17.0" weather="STORMY_RAIN"/>
        
        <Stage type="TAKEOFF" description="Take off into headwind toward East Channel">
            <Position x="-4100.0" y="130.0" z="150.0"/>
            <Radius>350.0</Radius>
            <MinSpeed>140.0</MinSpeed>
            <MinAltitude>100.0</MinAltitude>
        </Stage>

        <Stage type="WAYPOINT" description="Fight crosswinds across Central Ocean Channel">
            <Position x="500.0" y="220.0" z="-1200.0"/>
            <Radius>300.0</Radius>
        </Stage>

        <Stage type="DROP_PAYLOAD" event="DROP_CARGO" description="Drop medical crate over the stranded vessel [G]">
            <Position x="2800.0" y="90.0" z="-2100.0"/>
            <Radius>180.0</Radius>
        </Stage>

        <Stage type="RING_GATE" description="Descend low through North Bay Gap">
            <Position x="3800.0" y="45.0" z="-1600.0"/>
            <Radius>75.0</Radius>
        </Stage>

        <Stage type="LANDING" description="Amphibious water splashdown in East Mountain Bay">
            <Position x="4500.0" y="1.5" z="-1400.0"/>
            <Radius>260.0</Radius>
            <MaxSpeed>165.0</MaxSpeed>
        </Stage>
    </Mission>

    <!-- Mission 03: Smuggler's Run -->
    <Mission id="campaign_03_smuggler" 
             title="Smuggler's Run" 
             plane="sea_duck" 
             description="Deliver contraband under the radar ceiling. Keep altitude under 40m and drop cargo into the lagoon.">
        <Spawn x="4500.0" y="1.5" z="-1400.0" heading="240.0"/>
        <Environment time="20.5" weather="DENSE_FOG"/>

        <Stage type="TAKEOFF" description="Water liftoff heading Southwest">
            <Position x="3700.0" y="35.0" z="-2200.0"/>
            <Radius>300.0</Radius>
            <MinSpeed>130.0</MinSpeed>
            <MinAltitude>25.0</MinAltitude>
        </Stage>

        <Stage type="RING_GATE" description="Radar avoidance: Thread Sea Arch below 35m">
            <Position x="1800.0" y="32.0" z="-4500.0"/>
            <Radius>65.0</Radius>
        </Stage>

        <Stage type="DROP_PAYLOAD" event="DROP_CARGO" description="Drop drop-box to speedboat in South Lagoon [G]">
            <Position x="0.0" y="28.0" z="-7200.0"/>
            <Radius>160.0</Radius>
        </Stage>

        <Stage type="RING_GATE" description="Low skimming approach between sandbars">
            <Position x="0.0" y="22.0" z="-8000.0"/>
            <Radius>70.0</Radius>
        </Stage>

        <Stage type="LANDING" description="Touch down on South Atoll dirt strip">
            <Position x="0.0" y="23.5" z="-8500.0"/>
            <Radius>280.0</Radius>
            <MaxSpeed>170.0</MaxSpeed>
        </Stage>
    </Mission>

    <!-- Mission 04: Sabotage! -->
    <Mission id="campaign_04_sabotage" 
             title="Sabotage!" 
             plane="cargo" 
             description="Mid-air emergency: Fuel lines severed at 600m. Deadstick glide the heavy airframe to West Runway.">
        <Spawn x="-1500.0" y="650.0" z="800.0" heading="260.0"/>
        <Environment time="18.8" weather="OVERCAST"/>

        <Stage type="EVENT_TRIGGER" event="ENGINE_FAIL" description="Fuel starvation: ENGINES SHUT DOWN - GLIDE IMMEDIATELY">
            <Position x="-2100.0" y="580.0" z="600.0"/>
            <Radius>200.0</Radius>
        </Stage>

        <Stage type="RING_GATE" description="Keep pitch up: Clear Canyon Ridge Gate 1">
            <Position x="-3200.0" y="380.0" z="350.0"/>
            <Radius>85.0</Radius>
        </Stage>

        <Stage type="RING_GATE" description="Bank sharply into Runway Alignment Gate 2">
            <Position x="-5600.0" y="190.0" z="150.0"/>
            <Radius>80.0</Radius>
        </Stage>

        <Stage type="LANDING" description="Deadstick emergency landing on West Runway">
            <Position x="-4500.0" y="111.5" z="150.0"/>
            <Radius>280.0</Radius>
            <MaxSpeed>210.0</MaxSpeed>
        </Stage>
    </Mission>

    <!-- =================================================================== -->
    <!-- ACT II: INVASION (Missions 05 - 07)                                 -->
    <!-- =================================================================== -->

    <!-- Mission 05: Hostile Skies -->
    <Mission id="campaign_05_hostile" 
             title="Hostile Skies" 
             plane="jet_mk2" 
             description="A rogue PMC incurs into island airspace. Scramble the Jet Mk2 and splash two scout planes.">
        <Spawn x="-4850.0" y="111.5" z="150.0" heading="90.0"/>
        <Environment time="14.0" weather="CLEAR"/>
        
        <Enemies>
            <Enemy id="pmc_scout_1" name="PMC Recon Falcon 1" type="AIR_PATROL" targetStage="1">
                <Position x="800.0" y="420.0" z="600.0"/>
                <Health>100.0</Health>
                <Radius>25.0</Radius>
                <Speed>130.0</Speed>
            </Enemy>
            <Enemy id="pmc_scout_2" name="PMC Recon Falcon 2" type="AIR_PATROL" targetStage="1">
                <Position x="1000.0" y="450.0" z="900.0"/>
                <Health>100.0</Health>
                <Radius>25.0</Radius>
                <Speed>135.0</Speed>
            </Enemy>
        </Enemies>

        <Stage type="TAKEOFF" description="Full afterburner rotation heading East">
            <Position x="-1050.0" y="180.0" z="150.0"/>
            <Radius>400.0</Radius>
            <MinSpeed>260.0</MinSpeed>
            <MinAltitude>160.0</MinAltitude>
        </Stage>

        <Stage type="TARGET_STRIKE" event="DESTROY_TARGET" description="Eliminate PMC Recon pair [SPACE / LCTRL]">
            <Position x="1000.0" y="440.0" z="750.0"/>
            <Radius>250.0</Radius>
        </Stage>

        <Stage type="WAYPOINT" description="Regroup over East Island Radio Tower">
            <Position x="3200.0" y="320.0" z="-400.0"/>
            <Radius>300.0</Radius>
