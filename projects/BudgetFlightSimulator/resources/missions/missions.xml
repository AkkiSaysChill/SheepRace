    <!-- Mission 10: Dawn of Victory -->
    <Mission id="campaign_10_victory" 
             title="Dawn of Victory" 
             plane="jet_mk2" 
             description="The PMC Commander is fleeing in an armored prototype at dawn. Hunt him down and secure the island.">
