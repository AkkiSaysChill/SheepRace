        <Stage type="WAYPOINT" description="Skim low across Central Channel">
            <Position x="-1000.0" y="180.0" z="-1500.0"/>
            <Radius>350.0</Radius>
        </Stage>

        <Stage type="DROP_PAYLOAD" event="DROP_CARGO" description="Deploy munitions into Canyon Defense Post [G]">
